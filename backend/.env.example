DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=<db-password-not-the-anon-key>
JWT_SECRET=<random-256-bit-secret-e.g. openssl rand -base64 48>
JWT_EXPIRATION_DAYS=30
# Full E.164 format (+<country dial code><national number>, no spaces/dashes) — must match
# one of the countries configured in application.yml's app.phone.countries list.
BOOTSTRAP_OWNER_PHONE=+15550001111
BOOTSTRAP_OWNER_PIN=123456
BOOTSTRAP_OWNER_NAME=App Owner
PHOTO_STORAGE_DIR=./data/photos
SERVER_PORT=8080
# Comma-separated origins allowed to call this API from a browser (owner_dashboard's Vite dev server).
# Optional — defaults to http://localhost:5173,http://localhost:4173 if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
